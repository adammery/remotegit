{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteGit",
  "version": "0.1.0",
  "identifier": "sk.vocalio.remotegit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RemoteGit",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Git client for repositories on SSH servers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
