{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteGit",
  "version": "0.4.0",
  "identifier": "io.github.adammery.remotegit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RemoteGit",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "RemoteGit",
        "width": 360,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Git client for repositories on SSH servers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2RjJEQzI3RDYzRTBENzkKUldSNURUN1dKOXp5UmkvRllhZUEzTTZXREdvN2tpRDVUVkhiMWpCVGJNTHQvUjRtYlFFbjFqeVYK",
      "endpoints": [
        "https://github.com/adammery/remotegit/releases/latest/download/latest.json"
      ]
    }
  }
}
